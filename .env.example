DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://pediu:change-this-password@db:5432/pediu_db
TIME_ZONE=America/Recife
LANGUAGE_CODE=pt-br
# Em produção, use os domínios reais e uma chave secreta exclusiva.
# ALLOWED_HOSTS=seudominio.com,www.seudominio.com
# CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com
# Redis compartilhado recomendado para rate limiting com múltiplas instâncias.
# REDIS_URL=redis://redis-interno:6379/1
# HSTS: habilitar somente após confirmar HTTPS em todos os hosts.
# SECURE_HSTS_SECONDS=0
